# ---------------------------------------------------------------
# Ventrio environment variables
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------

# SQLite database file.
# Local:   file:./dev.db            (created inside /prisma)
# Railway: file:/app/data/ventrio.db (mount a volume at /app/data)
DATABASE_URL="file:./dev.db"

# Auth.js session encryption secret. Generate with: npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=""

# Discord OAuth2 application (https://discord.com/developers/applications)
# Redirect URL to add in Discord: <your site>/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Public site URL (used for OAuth redirects behind a proxy).
# Local: http://localhost:3000   Production: https://your-domain.com
AUTH_URL="http://localhost:3000"

# Comma-separated Discord user IDs that get access to /admin.
# Discord: Settings > Advanced > Developer Mode, then right-click your name > Copy User ID.
ADMIN_DISCORD_IDS=""

# Official Discord server invite (used everywhere the site links to Discord).
DISCORD_INVITE_URL="https://discord.gg/J5y9A8Asch"

# Pre-launch teaser: visitors only see the teaser on "/" until this is "true".
# Flipping it to "true" also DMs everyone on the waitlist once.
SITE_LAUNCHED="false"

# Bot token from the SAME Discord application as AUTH_DISCORD_ID (Bot tab > Reset Token).
# Used to add signed-in members to the server and send the launch DM.
DISCORD_BOT_TOKEN=""

# Optional: Discord server ID. If blank it is looked up from DISCORD_INVITE_URL.
DISCORD_GUILD_ID=""

# Contact / support email shown on /contact and in the footer (leave blank to show a placeholder).
CONTACT_EMAIL=""

# Calendly link shown to coach applicants once an admin marks them "Interview".
CALENDLY_URL="https://calendly.com/dev-jake317/30min"

# Optional: Discord webhook URL that receives new coach applications
# (Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL).
DISCORD_APPLICATIONS_WEBHOOK_URL=""

# Coach Dashboard (/coach): Discord role IDs that unlock it (checked with DISCORD_BOT_TOKEN).
# Blank = the default Ventrio coach roles.
COACH_ROLE_IDS=""

# Optional: Discord role IDs that also get /coach/leadership (ADMIN_DISCORD_IDS always do).
LEADERSHIP_ROLE_IDS=""

# Optional: channel where the bot keeps the coaching schedule embed (default: Ventrio's schedule channel).
DISCORD_SCHEDULE_CHANNEL_ID=""

# Optional: channel linked at the bottom of the schedule embed (e.g. #workshop-announcements).
DISCORD_WORKSHOP_CHANNEL_ID=""

# Optional: Coach Interview link sent in the "Accepted" application DM.
COACH_INTERVIEW_URL="https://calendly.com/ggriffin15/ventrio-coach-interview"
