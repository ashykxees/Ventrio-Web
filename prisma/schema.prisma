// Ventrio database schema.
// SQLite has no native enums, so enum-like columns are strings validated in lib/validation.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  registrations    Registration[]
  submissions      Submission[]
  coachApplication CoachApplication?
  coachProfile     CoachProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Members ----------

// One profile per member, linked to the stable Discord user ID from OAuth.
// Discord fields are refreshed on every sign-in and are never user-editable.
model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  discordId       String  @unique
  discordUsername String
  discordAvatar   String?

  // Public URL handle (/members/[handle]); never an internal ID.
  handle      String @unique
  displayName String
  bio         String @default("")
  projectName String @default("")
  interests   String @default("") // comma-separated
  skills      String @default("") // comma-separated
  website     String @default("")
  socialLinks String @default("") // newline-separated URLs

  // Privacy: profiles are private until the member opts in.
  isPublic        Boolean @default(false)
  showAvatar      Boolean @default(true)
  showBio         Boolean @default(true)
  showProjectName Boolean @default(true)
  showInterests   Boolean @default(true)
  showSkills      Boolean @default(true)
  showLinks       Boolean @default(false)

  // Pre-launch waitlist: guild auto-join and the one-time launch DM.
  joinedGuildAt     DateTime?
  notifyOnLaunch    Boolean   @default(true)
  launchNotifiedAt  DateTime?
  launchNotifyError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Content ----------

model Event {
  id               String    @id @default(cuid())
  title            String
  description      String
  type             String // CLASS | COACHING | NETWORKING | FAITH | PITCH | OTHER
  startsAt         DateTime
  endsAt           DateTime?
  timezone         String
  format           String // ONLINE | IN_PERSON | HYBRID
  location         String    @default("")
  capacity         Int?
  registrationMode String    @default("NONE") // NONE | SITE | EXTERNAL
  registrationUrl  String    @default("")
  organizer        String    @default("")
  status           String    @default("DRAFT") // DRAFT | PUBLISHED | CANCELLED | ARCHIVED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  registrations Registration[]

  @@index([status, startsAt])
}

model Lesson {
  id                 String    @id @default(cuid())
  title              String
  description        String
  details            String    @default("")
  instructor         String    @default("")
  type               String // LESSON | CLASS | RESOURCE | COACHING
  category           String // see LESSON_CATEGORIES
  startsAt           DateTime?
  endsAt             DateTime?
  timezone           String    @default("America/New_York")
  registrationStatus String    @default("NOT_REQUIRED") // NOT_REQUIRED | OPEN | CLOSED
  capacity           Int?
  resourceUrl        String    @default("")
  status             String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  registrations Registration[]

  @@index([status, category])
}

model Competition {
  id               String    @id @default(cuid())
  title            String
  summary          String
  description      String    @default("")
  eligibility      String    @default("")
  requirements     String    @default("")
  judgingCriteria  String    @default("")
  prizes           String    @default("")
  prizesVerified   Boolean   @default(false)
  opensAt          DateTime?
  deadline         DateTime?
  timezone         String    @default("America/New_York")
  phase            String    @default("UPCOMING") // UPCOMING | OPEN | IN_REVIEW | COMPLETED
  status           String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  submissionFields String    @default("[]") // JSON: SubmissionField[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  submissions Submission[]
}

// Feedback, score and result are visible only to the submitter and admins.
model Submission {
  id            String   @id @default(cuid())
  competitionId String
  userId        String
  answers       String // JSON: Record<fieldKey, string>
  status        String   @default("SUBMITTED") // SUBMITTED | IN_REVIEW | FINALIST | WINNER | NOT_SELECTED | WITHDRAWN
  score         Int?
  feedback      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
}

// A registration targets exactly one event or one lesson.
model Registration {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  lessonId  String?
  status    String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@unique([userId, lessonId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Coach applications from /careers. Identity comes from the Discord session, never the form.
model CoachApplication {
  id               String   @id @default(cuid())
  userId           String   @unique
  discordId        String
  discordUsername  String
  email            String
  position         String // MARKETING | STRATEGY | BOTH
  experience       String
  expertise        String
  practicalExample String
  teachingPlan     String
  feedbackApproach String
  availability     String
  motivation       String
  links            String   @default("")
  status           String   @default("SUBMITTED") // SUBMITTED | IN_REVIEW | INTERVIEW | ACCEPTED | NOT_SELECTED
  adminNotes       String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ---------- Coach Dashboard (/coach) ----------
// Access comes from Discord server roles (COACH_ROLE_IDS) verified with the bot, never from the client.
// Actor/reviewer columns hold User IDs; coach-owned records point at CoachProfile.

model CoachProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  discordId        String    @unique
  status           String    @default("ACTIVE") // ACTIVE | DEACTIVATED
  coachRole        String    @default("") // assigned by leadership, e.g. Marketing Coach
  expertise        String    @default("")
  bio              String    @default("")
  responsibilities String    @default("")
  timezone         String    @default("America/New_York")
  availability     String    @default("")
  startDate        DateTime?
  leadershipNotes  String    @default("")
  discordRoles     String    @default("") // comma-separated role IDs from the last check
  rolesCheckedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    CoachSession[]
  requests    CoachRequest[]
  assignments ProjectAssignment[]
  submissions ProjectSubmission[]
  payroll     PayrollRecord[]
  tasks       TaskAssignment[]
  reviews     PerformanceReview[]
}

model CoachSession {
  id                 String    @id @default(cuid())
  coachId            String
  title              String
  sessionType        String
  topic              String
  objectives         String    @default("")
  audience           String    @default("")
  startAt            DateTime
  durationMinutes    Int
  timezone           String
  platform           String
  meetingUrl         String    @default("")
  prepNotes          String    @default("")
  resources          String    @default("")
  notesForLeadership String    @default("")
  status             String    @default("SCHEDULED") // SCHEDULED | RESCHEDULED | CANCELLED | COMPLETED | NEEDS_ATTENTION
  // ISO week ("2026-W42") this session fulfils; null for extra or cancelled sessions.
  weekKey            String?
  leadershipFeedback String    @default("")
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  coach  CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  report SessionReport?
  events SessionEvent[]

  @@unique([coachId, weekKey])
  @@index([startAt])
}

model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  actorId   String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionReport {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  submittedById String
  occurred      Boolean
  attendance    Int?
  topicsCovered String   @default("")
  resourcesUsed String   @default("")
  followUp      String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CoachRequest {
  id            String    @id @default(cuid())
  coachId       String
  category      String
  title         String
  description   String
  requestedDate DateTime?
  links         String    @default("")
  status        String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | MORE_INFO | APPROVED | REJECTED | WITHDRAWN
  reviewerId    String?
  feedback      String    @default("") // visible to the coach
  internalNotes String    @default("") // leadership only
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coach   CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  history RequestHistory[]

  @@index([status, createdAt])
}

model RequestHistory {
  id             String   @id @default(cuid())
  requestId      String
  actorId        String
  previousStatus String?
  newStatus      String
  comment        String   @default("")
  createdAt      DateTime @default(now())

  request CoachRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  projectType String   @default("")
  status      String   @default("OPEN") // OPEN | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ProjectAssignment[]
}

// The agreed fee lives on the assignment; no universal rate is assumed.
model ProjectAssignment {
  id          String   @id @default(cuid())
  projectId   String
  coachId     String
  amountCents Int
  currency    String   @default("USD")
  terms       String   @default("")
  assignedAt  DateTime @default(now())

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coach       CoachProfile        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]
  payroll     PayrollRecord[]

  @@unique([projectId, coachId])
}

model ProjectSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  coachId      String
  description  String
  completedAt  DateTime
  links        String    @default("")
  notes        String    @default("")
  status       String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | REVISION | APPROVED | REJECTED
  reviewerId   String?
  feedback     String    @default("")
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  coach      CoachProfile      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  payroll    PayrollRecord?
}

// One record per approved submission (unique submissionId). Approval never marks it paid.
model PayrollRecord {
  id           String    @id @default(cuid())
  coachId      String
  submissionId String?   @unique
  assignmentId String?
  amountCents  Int
  currency     String    @default("USD")
  period       String // YYYY-MM
  status       String    @default("PENDING") // PENDING | PAID | VOID
  isAdjustment Boolean   @default(false)
  approvedById String
  approvedAt   DateTime  @default(now())
  paidById     String?
  paidAt       DateTime?
  adminNotes   String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  coach      CoachProfile       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  submission ProjectSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  assignment ProjectAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([coachId, period])
}

model CoachResource {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String
  authorId    String
  url         String   @default("")
  content     String   @default("")
  status      String   @default("DRAFT") // DRAFT | SUBMITTED | REVISION | PUBLISHED | ARCHIVED
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews ResourceReview[]

  @@index([status, category])
}

model ResourceReview {
  id         String   @id @default(cuid())
  resourceId String
  reviewerId String
  status     String
  feedback   String   @default("")
  createdAt  DateTime @default(now())

  resource CoachResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model CoachTask {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  createdById String
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueAt       DateTime?
  timezone    String    @default("America/New_York")
  links       String    @default("")
  checklist   String    @default("") // one item per line
  status      String    @default("OPEN") // OPEN | CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments TaskAssignment[]
  comments    TaskComment[]
}

model TaskAssignment {
  id          String    @id @default(cuid())
  taskId      String
  coachId     String
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | SUBMITTED | REVISION | COMPLETED | CANCELLED
  submission  String    @default("")
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  task  CoachTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([taskId, coachId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  coachId   String? // thread this comment belongs to (one per assignee)
  authorId  String
  comment   String
  createdAt DateTime @default(now())

  task CoachTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model PerformanceReview {
  id             String    @id @default(cuid())
  coachId        String
  reviewerId     String
  periodStart    DateTime
  periodEnd      DateTime
  content        String    @default("{}") // JSON: Record<category, text>
  rating         String    @default("")
  internalNotes  String    @default("")
  status         String    @default("DRAFT") // DRAFT | FINAL
  finalizedAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
}

model CoachAnnouncement {
  id        String    @id @default(cuid())
  authorId  String
  title     String
  body      String
  category  String    @default("General")
  audience  String    @default("") // blank = all active coaches, otherwise a coach role
  important Boolean   @default(false)
  pinned    Boolean   @default(false)
  status    String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reads AnnouncementRead[]
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement CoachAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

model CoachNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String    @default("")
  href      String    @default("")
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Policy {
  id             String   @id @default(cuid())
  title          String
  category       String
  requiresAck    Boolean  @default(true)
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  currentVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions PolicyVersion[]
}

model PolicyVersion {
  id          String   @id @default(cuid())
  policyId    String
  version     Int
  content     String
  createdById String
  publishedAt DateTime @default(now())

  policy Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  acks   PolicyAck[]

  @@unique([policyId, version])
}

model PolicyAck {
  id              String   @id @default(cuid())
  policyVersionId String
  userId          String
  acknowledgedAt  DateTime @default(now())

  version PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, userId])
}

model CoachSetting {
  key         String   @id
  value       String // JSON
  updatedById String
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
